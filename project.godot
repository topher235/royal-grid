; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="royal-grid"
config/description="Enter an interesting project description here!"
run/main_scene="uid://d2py1cvj6onlm"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"

[autoload]

Sprites="*res://autoloads/sprites.gd"
Events="*res://autoloads/events.gd"
SoundManager="*res://addons/sound_manager/sound_manager.gd"
Sounds="*res://autoloads/sounds.gd"
Log="*res://autoloads/log.gd"
SaveManager="*res://autoloads/save_manager.gd"
UserConfig="*res://autoloads/user_config.gd"

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]

movie_writer/movie_file="/Users/crhurt/Movies/Gambit/showcase-main-menu.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/sound_manager/plugin.cfg")

[global_group]

gameboard=""
tiles=""
effects=""

[gui]

common/snap_controls_to_pixels=false
theme/custom_font="uid://dpqtkgu5mbhtc"

[internationalization]

locale/translations=PackedStringArray("res://localization/localization.fr.translation", "res://localization/localization.en.translation", "res://localization/localization.es.translation")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
